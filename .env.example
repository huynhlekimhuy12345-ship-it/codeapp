# Copy thành .env (cùng thư mục với docker-compose.yml). KHÔNG commit .env.
# Mật khẩu SA phải đủ mạnh theo chuẩn SQL Server (tối thiểu 8 ký tự,
# có chữ hoa, chữ thường, số và ký tự đặc biệt) nếu không container
# SQL Server sẽ tự dừng ngay sau khi khởi động.
MSSQL_SA_PASSWORD=
JWT_SECRET=
# Đăng nhập Google: điền CÙNG một Client ID vào cả 2 dòng
# (VITE_... nhúng vào frontend lúc build, GOOGLE_... để backend kiểm tra)
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
# Email gửi mã đặt lại mật khẩu (để trống = mã chỉ ghi log container)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
