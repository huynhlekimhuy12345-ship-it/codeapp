# BẮT BUỘC ở production: chuỗi ngẫu nhiên dài (vd: openssl rand -hex 32)
JWT_SECRET=
# Danh sách domain frontend được phép gọi API, cách nhau dấu phẩy (vd: https://shop.example.com)
CORS_ORIGIN=

# Đăng nhập Google: Client ID từ Google Cloud Console (để trống = tắt kiểm tra aud)
GOOGLE_CLIENT_ID=
# Email gửi mã đặt lại mật khẩu (để trống = mã chỉ ghi log server, không gửi thật)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
